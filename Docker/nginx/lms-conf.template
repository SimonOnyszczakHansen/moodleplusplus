server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    root /var/www/lms-frontend/current;
    index index.html;

    # Health endpoint used by the deployment pipeline
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    # Cache versioned Angular assets
    location ~* \.(?:js|css|woff2?|ttf|eot|ico|svg|png|jpg|jpeg|gif|webp)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Angular SPA
    location / {
        try_files $uri $uri/ /index.html;
    }
}